<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CakePet</AssemblyName><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><DefineConstants>$(DefineConstants);NATIVE_HOST</DefineConstants>
    <ApplicationManifest>../CakePet.Windows/app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../CakePet.Windows/Assets/CakePet.ico')">../CakePet.Windows/Assets/CakePet.ico</ApplicationIcon>
